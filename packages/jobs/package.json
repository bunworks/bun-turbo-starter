{
  "name": "@acme/jobs",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./src/workflows/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "worker": "bun --env-file=../../.env --watch run src/worker.ts",
    "start": "bun run src/worker.ts",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@acme/config": "workspace:*",
    "@acme/emails": "workspace:*",
    "@hatchet-dev/typescript-sdk": "1.43.0"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
