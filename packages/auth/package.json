    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acme/config": "workspace:*",
    "@acme/db": "workspace:*",
    "better-auth": "1.7.13"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@better-auth/cli": "1.4.21",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
