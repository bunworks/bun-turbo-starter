{
  "name": "@acme/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./roles": "./src/roles.ts",
    "./env": "./env.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "biome format .",
