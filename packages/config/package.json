{
  "name": "@acme/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && tsc --tsBuildInfoFile dist/.tsbuildinfo",
    "build:watch": "tsdown --watch",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc --tsBuildInfoFile dist/.tsbuildinfo",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/node": "26.6.5",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  }
}
