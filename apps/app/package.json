    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^6.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation": "0.219.0",
    "@orpc/client": "2.0.0-beta.46",
